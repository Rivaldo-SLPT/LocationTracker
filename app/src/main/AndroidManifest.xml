<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================= -->
    <!-- UBICACIÓN -->
    <!-- ================================================= -->

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <!-- ================================================= -->
    <!-- INTERNET Y ESTADO DE RED -->
    <!-- ================================================= -->

    <!-- Permite enviar los registros hacia AWS -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Permite conocer el estado de la conexión -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- ================================================= -->
    <!-- FOREGROUND SERVICE -->
    <!-- ================================================= -->

    <!-- Permite ejecutar un Foreground Service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground Service específicamente para ubicación -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />


    <!-- Mantiene la CPU despierta para registrar cada minuto
         aunque la pantalla esté apagada -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />


    <!-- ================================================= -->
    <!-- NOTIFICACIONES -->
    <!-- ================================================= -->

    <!-- Android 13+ permite al usuario controlar las notificaciones -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />


    <!-- ================================================= -->
    <!-- APLICACIÓN -->
    <!-- ================================================= -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocationTracker">


        <!-- Servicio que realiza el rastreo de ubicación -->
        <service
            android:name=".LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />


        <!-- Actividad principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LocationTracker">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>