<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de copia de seguridad para Android 12 y posteriores.
   El historial de ubicaciones es información sensible: no se
   sube a la nube ni se transfiere a otro dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
